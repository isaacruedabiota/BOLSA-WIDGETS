<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BolsaWidgetsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.BolsaWidgets">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BolsaWidgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WatchlistWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_watchlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchlist_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SparklineWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_sparkline_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sparkline_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.HeatmapWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_heatmap_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heatmap_widget_info" />
        </receiver>

        <!-- Started by the launcher before the widget is placed, so exported. -->
        <activity
            android:name=".widget.HeatmapConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.BolsaWidgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.SparklineConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.BolsaWidgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            WorkManager is initialised on demand from BolsaWidgetsApp so that Hilt can
            supply the worker factory. Only its initializer is removed; any other
            androidx.startup component keeps working.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
